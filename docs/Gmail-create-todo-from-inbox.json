      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-480, 0]
    },
    {
      "parameters": {
        "operation": "getAll",
        "returnAll": true,
        "filters": {
          "q": "in:inbox subject:create-todo newer_than:2d"
        },
        "options": {}
      },
      "id": "a1b2c3d4-gmail-get",
      "name": "Gmail — create-todo recentes",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [-240, 0],
      "credentials": {
        "gmailOAuth2": {
          "id": "CONFIGURE_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const CREATE_TODO_PREFIX = /^create-todo\\s*/i;\n\nfunction normalizeEmailSlug(value) {\n  if (value == null || typeof value !== 'string') return '';\n  return value\n    .normalize('NFD')\n    .replace(/\\p{M}/gu, '')\n    .toLowerCase()\n    .trim()\n    .replace(/[^a-z0-9]+/g, '-')\n    .replace(/^-+|-+$/g, '');\n}\n\nconst items = [];\n\nfor (const item of $input.all()) {\n  const msg = item.json;\n  const subject = msg.subject || msg.Subject || '';\n  if (!CREATE_TODO_PREFIX.test(subject)) continue;\n\n  const title = subject.replace(CREATE_TODO_PREFIX, '').trim();\n  if (!title) continue;\n\n  const emailSlug = normalizeEmailSlug(title);\n  if (!emailSlug) continue;\n\n  const messageId = msg.id || msg.messageId;\n  if (!messageId) continue;\n\n  items.push({\n    title,\n    description: (msg.textPlain || msg.text || msg.snippet || '').trim(),\n    emailSlug,\n    gmailMessageId: messageId\n  });\n}\n\nif (items.length === 0) return [];\n\nreturn [{ json: { items } }];"
      },
      "id": "a1b2c3d4-code",
      "name": "Preparar create-todo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://cdns-systems-todo-server.ccuexx.easypanel.host/api/external/todos/batch",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ items: $json.items }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-http",
      "name": "Criar tarefas no app",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "GG36vwNbcaQxm534",
          "name": "Header Auth - Todo"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first()?.json || {};\nconst results = Array.isArray(body.results) ? body.results : [];\n\nreturn results\n  .filter(result => result && result.gmailMessageId)\n  .map(result => ({\n    json: {\n      gmailMessageId: result.gmailMessageId,\n      ok: result.ok === true,\n      created: result.created === true,\n      emailSlug: result.emailSlug || '',\n      error: result.error || ''\n    }\n  }));"
      },
      "id": "a1b2c3d4-split",
      "name": "Separar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 0]
    },
