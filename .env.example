# IMPORTANTE: Este é um arquivo de exemplo
# Copie este arquivo para .env na raiz do projeto e configure suas variáveis

# Backend
PORT=3001
NODE_ENV=production
# Bind no container (Easypanel/Docker). NÃO use domínio nem IP público da VPS.
SERVER_HOST=0.0.0.0
# Volume persistente em produção (Easypanel monta em /data)
DATA_FILE_PATH=/data/data.json
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Segurança API (n8n, webhooks, integrações)
# IMPORTANTE: Gere uma chave aleatória forte (ex: openssl rand -hex 32)
# Em produção (NODE_ENV=production), API_KEY é obrigatória
# Em desenvolvimento, se não configurar, a API externa ficará pública
API_KEY=your-api-key-here

# Frontend
VITE_API_URL=http://localhost:3001
